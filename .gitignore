
# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# License: CC0-1.0

# Temporary and generated directories
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Memory captures and recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store Tools (uncomment if needed)
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider generated plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE caches
.vs/
.gradle/
.consulo/

# Autogenerated solution and project files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated metadata for debugging files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
mono_crash.*

# Build outputs
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated files
crashlytics-build.properties

# TestRunner generated scenes
InitTestScene*.unity*

# Addressables generated files
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes for play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated scene dependency cache
/[Aa]ssets/[Ss]ceneDependencyCache*
